{
    "lateral_water_map": {
        "name": "lateral_water_map",
        "display_name": "Lateral As-Applied Water Map",
        "type": "PRO",
        "visibility": "COR",
        "allow_many": true,
        "description": "Visualises a lateral-move irrigator's as-applied water map: reads recorded flow / cart-GPS / end-gun tag history, projects the cart onto the travel path and renders per-strip applied depth (mm) as coloured rectangles on a Google Map. All computation is client-side in the widget.",
        "long_description": "README.md",
        "depends_on": [],
        "owner_org_key": "",
        "handler": "src.lateral_water_map.handler",
        "lambda_config": {
            "Environment": {},
            "Runtime": "python3.13",
            "Timeout": 300,
            "Handler": "src.lateral_water_map.handler",
            "MemorySize": 128,
            "Architectures": [
                "arm64"
            ]
        },
        "image_name": null,
        "repo_branch": "main",
        "staging_config": {},
        "export_config_command": "export-config-watermap",
        "export_ui_command": "export-ui-watermap",
        "build_widget_command": "npm --prefix widget run build",
        "widget": "widget/assets/LateralWaterMapWidget.js",
        "run_command": null,
        "key": null,
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
