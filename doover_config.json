                    "x-name": "baud_rate",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "RS232 baud rate for the VCP link.",
                    "default": 9600,
                    "x-position": 1
                },
                "poll_interval_s": {
                    "title": "Poll Interval (s)",
                    "x-name": "poll_interval_s",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How often to poll the panel over VCP.",
                    "default": 10.0,
                    "x-position": 2
