                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Units the flow tag is reported in.",
                    "default": "L/s",
                    "x-position": 8
                },
                "path_start_lat": {
                    "title": "Path Start Latitude",
                    "x-name": "path_start_lat",
                    "x-hidden": false,
                    "type": "number",
                    "x-required": true,
                    "description": "Latitude of one end of the travel path.",
                    "x-position": 9
                },
                "path_start_lon": {
                    "title": "Path Start Longitude",
                    "x-name": "path_start_lon",
                    "x-hidden": false,
