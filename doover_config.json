                            "description": "Name of the tag within that app.",
                            "x-position": 2
                        }
                    },
                    "additionalElements": true,
                    "required": [
                        "app_name",
                        "tag_name"
                    ],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                },
                "lon_tag": {
                    "title": "Longitude Tag",
                    "x-name": "lon_tag",
                    "x-hidden": false,
                    "type": [
                        "object",
                        "null"
                    ],
                    "x-required": false,
                    "description": "(Two tags mode) tag carrying the cart longitude.",
                    "default": null,
                    "x-position": 2,
                    "properties": {
                        "app_name": {
                            "title": "Application",
