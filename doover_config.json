                    "x-name": "gps_tag",
                    "x-hidden": false,
                    "type": [
                        "object",
                        "null"
                    ],
                    "x-required": false,
                    "description": "(Single tag mode) tag whose value holds lat & lon.",
                    "default": null,
                    "x-position": 3,
                    "properties": {
                        "app_name": {
                            "title": "Application",
