                "end_gun_extra_m": {
                    "title": "End-gun Extra Extent (m)",
                    "x-name": "end_gun_extra_m",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Extra metres added to each side when the end-gun is on.",
                    "default": 0.0,
                    "x-position": 15
                },
                "strip_resolution_m": {
                    "title": "Strip Resolution (m)",
                    "x-name": "strip_resolution_m",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Length of each map strip along the travel path, in metres.",
                    "default": 5.0,
                    "x-position": 16
                },
                "track_smoothing_minutes": {
                    "title": "Track Smoothing (minutes)",
                    "x-name": "track_smoothing_minutes",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Half-window for smoothing the cart's along-path position before computing depth. The GPS publishes on a distance threshold, so a small position error shows up as one fast strip beside one slow strip -- a stripe the machine never applied. This averages that out. Set it to the shortest genuine stop you still need to see on the map: dwells much shorter than the window get smoothed away. 0 disables.",
                    "default": 60.0,
                    "x-position": 17,
                    "minimum": 0
                },
                "dormancy_days": {
                    "title": "Event Dormancy (days)",
                    "x-name": "dormancy_days",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "A new irrigation event starts when flow resumes after at least this many days without flow.",
                    "default": 5.0,
                    "x-position": 18
                },
                "google_maps_api_key": {
                    "title": "Google Maps API Key",
