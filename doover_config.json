                    "x-position": 0
                },
                "lat_tag": {
                    "title": "Latitude Tag",
                    "x-name": "lat_tag",
                    "x-hidden": false,
                    "type": [
                        "object",
                        "null"
                    ],
                    "x-required": false,
                    "description": "(Two tags mode) tag carrying the cart latitude.",
                    "default": null,
                    "x-position": 1,
                    "properties": {
                        "app_name": {
                            "title": "Application",
                            "x-name": "app_name",
                            "x-hidden": false,
                            "format": "doover-application",
