    "valley_lateral_irrigator": {
        "name": "valley_lateral_irrigator",
        "display_name": "Valley Lateral Irrigator",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Device app for Valley lateral-move panels (VCP over RS232). SKELETON \u2014 publishes flow / cart GPS / end-gun / pressure tags that the lateral water-map widget consumes.",
        "long_description": "README.md",
        "depends_on": [],
        "owner_org_key": "",
        "image_name": "ghcr.io/getdoover/lateral-irrigator:main",
        "container_registry_profile_key": "",
        "build_args": "--platform linux/amd64,linux/arm64",
        "export_config_command": "export-config-valley",
        "export_ui_command": "export-ui-valley",
        "repo_branch": "main",
        "key": null,
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "serial_port": {
                    "title": "Serial Port",
                    "x-name": "serial_port",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
