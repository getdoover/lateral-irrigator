            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "water_flow": {
                    "name": "water_flow",
                    "type": "uiVariable",
                    "displayString": "Water Flow",
                    "showActivity": true,
                    "position": 51,
                    "hidden": false,
                    "varType": "float",
                    "currentValue": "$tag.app().water_flow:number:0",
                    "decPrecision": 1
