                    ],
                    "x-required": false,
                    "description": "Optional boolean tag indicating the end-gun is on. Leave blank if the lateral has no end-gun.",
                    "default": null,
                    "x-position": 7,
                    "properties": {
                        "app_name": {
                            "title": "Application",
                            "x-name": "app_name",
                            "x-hidden": false,
                            "format": "doover-application",
                            "type": "string",
                            "x-required": true,
                            "description": "App on this agent that publishes the tag.",
                            "x-position": 1
                        },
                        "tag_name": {
                            "title": "Tag Name",
                            "x-name": "tag_name",
                            "x-hidden": false,
                            "type": "string",
